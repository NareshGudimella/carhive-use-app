# Resolve react_native_pods.rb with node to allow for hoisting
 def node_require(script)
   # Resolve script with node to allow for hoisting
   require Pod::Executable.execute_command('node', ['-p',
     "require.resolve(
       '#{script}',
      {paths: [process.argv[1]]},
     )", __dir__]).strip
end
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')
platform :ios, min_ios_version_supported
prepare_react_native_project!

# @react-native-firebase 27 resolves Firebase through Swift Package Manager, which requires
# dynamic framework linkage (https://rnfirebase.io/ios-spm).
linkage = ENV['USE_FRAMEWORKS'] || 'dynamic'
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'carhive_user' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :fabric_enabled => false,
    :hermes_enabled => true,
    :new_arch_enabled => true
  )
  setup_permissions([
    'LocationWhenInUse',
    'Camera',
    'PhotoLibrary'
  ])
  
  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 rejects pod targets (mostly resource bundles) below iOS 15.0.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end

    # With dynamic frameworks (required by react-native-firebase 27) every pod links on its own,
    # so frameworks that used to be resolved by the final app link must be added per pod.
    extra_frameworks = {
      # razorpay-pod's framework does not inherit the frameworks of razorpay-core-pod.
      'react-native-razorpay' => ['Razorpay', 'RazorpayCore'],
      # Uses kUTType*/UTType constants and the Photos and AVFoundation APIs.
      'react-native-image-picker' => ['MobileCoreServices', 'UniformTypeIdentifiers', 'Photos', 'PhotosUI', 'AVFoundation'],
    }
    installer.pods_project.targets.each do |target|
      frameworks = extra_frameworks[target.name]
      next unless frameworks
      target.build_configurations.each do |config|
        config.build_settings['OTHER_LDFLAGS'] = ['$(inherited)'] + frameworks.map { |f| "-framework #{f}" }
      end
    end
  end
end
